{
  "openapi": "3.1.0",
  "info": {
    "title": "OB1 GPT Actions",
    "version": "0.1.0",
    "description": "Access Open Brain memories through a REST adapter."
  },
  "servers": [
    {
      "url": "https://ob1-actions.example.invalid"
    }
  ],
  "security": [
    {
      "actionKey": []
    }
  ],
  "components": {
    "securitySchemes": {
      "actionKey": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
    "/actions/search": {
      "post": {
        "operationId": "search",
        "description": "Search OB1 memories and return identifiers and titles.",
        "x-openai-isConsequential": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8000
                  }
                },
                "required": [
                  "query"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          },
                          "url": {
                            "type": "string",
                            "format": "uri"
                          }
                        },
                        "required": [
                          "id",
                          "title"
                        ]
                      }
                    }
                  },
                  "required": [
                    "results"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Request, authentication, or upstream failure. Capture may have completed; do not automatically retry.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "writeMayHaveSucceeded": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/actions/fetch": {
      "post": {
        "operationId": "fetch",
        "description": "Retrieve the full text and metadata of an OB1 thought.",
        "x-openai-isConsequential": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "id"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "text": {
                      "type": "string"
                    },
                    "metadata": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "required": [
                    "id",
                    "title",
                    "text"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Request, authentication, or upstream failure. Capture may have completed; do not automatically retry.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "writeMayHaveSucceeded": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/actions/search_thoughts": {
      "post": {
        "operationId": "search_thoughts",
        "description": "Search OB1 memories by meaning.",
        "x-openai-isConsequential": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8000
                  },
                  "limit": {
                    "default": 10,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 50
                  },
                  "threshold": {
                    "default": 0.5,
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "query"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "text"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Request, authentication, or upstream failure. Capture may have completed; do not automatically retry.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "writeMayHaveSucceeded": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/actions/list_thoughts": {
      "post": {
        "operationId": "list_thoughts",
        "description": "List recent OB1 thoughts with optional filters.",
        "x-openai-isConsequential": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "limit": {
                    "default": 10,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 50
                  },
                  "type": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "topic": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "person": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "days": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 36500
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "text"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Request, authentication, or upstream failure. Capture may have completed; do not automatically retry.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "writeMayHaveSucceeded": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/actions/thought_stats": {
      "post": {
        "operationId": "thought_stats",
        "description": "Get OB1 thought counts, topics, types, and people.",
        "x-openai-isConsequential": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {},
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "text"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Request, authentication, or upstream failure. Capture may have completed; do not automatically retry.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "writeMayHaveSucceeded": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/actions/capture_thought": {
      "post": {
        "operationId": "capture_thought",
        "description": "Save a thought in OB1. Do not automatically retry after an error or timeout; the write may have succeeded.",
        "x-openai-isConsequential": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "content": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20000
                  }
                },
                "required": [
                  "content"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "text"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Request, authentication, or upstream failure. Capture may have completed; do not automatically retry.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "writeMayHaveSucceeded": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
